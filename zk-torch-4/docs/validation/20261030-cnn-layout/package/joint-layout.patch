+fn explicit_nonpower_batch_survives_pad_and_pool_registered_views() {
+    let b=3usize;let c=3usize;let (h,w)=(4usize,6usize);let (cp,bp,hp,wp)=(4,4,4,8);
+    for poison in [1i128<<40,-(1i128<<40)] {
