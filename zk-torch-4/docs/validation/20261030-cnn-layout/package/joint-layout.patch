+        for ib in 0..b {for ic in 0..c {for ih in 0..h {for iw in 0..w {
+            raw[iw+wp*(ih+hp*(ic+cp*ib))]=(ib*100+ic*10+ih*2+iw) as i128;
+        }}}}
